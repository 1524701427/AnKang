.page.data-v-603752d0 {
  min-height: 100vh;
  padding: 34rpx 34rpx 46rpx;

  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(224, 239, 229, .9),
      transparent 38%
    ),
    linear-gradient(
      180deg,
      #f7f8f3 0%,
      #f5f3ec 100%
    );
}
.topbar.data-v-603752d0 {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.brand.data-v-603752d0 {
  display: block;

  font-size: 52rpx;
  line-height: 1;

  font-weight: 900;

  letter-spacing: 6rpx;

  color: #234d3d;
}
.date.data-v-603752d0 {
  display: block;

  margin-top: 16rpx;

  font-size: 30rpx;

  color: #6f7a73;
}
.weather.data-v-603752d0 {
  padding: 14rpx 20rpx;

  border-radius: 22rpx;

  background: rgba(255,255,255,.72);

  font-size: 28rpx;

  color: #55675e;
}


/* 今日状态 */
.status-card.data-v-603752d0 {
  margin-top: 34rpx;

  min-height: 112rpx;

  padding: 26rpx 30rpx;

  border-radius: 30rpx;

  display: flex;
  align-items: center;

  background: rgba(255,255,255,.75);

  border: 2rpx solid rgba(218,229,219,.9);
}
.status-dot.data-v-603752d0 {
  width: 22rpx;
  height: 22rpx;

  margin-right: 22rpx;

  border-radius: 50%;

  background: #4f8b68;

  box-shadow:
    0 0 0 12rpx
    rgba(79,139,104,.10);
}
.status-title.data-v-603752d0 {
  display: block;

  font-size: 36rpx;

  font-weight: 900;

  color: #263c31;
}
.status-sub.data-v-603752d0 {
  display: block;

  margin-top: 6rpx;

  font-size: 26rpx;

  color: #718078;
}


/* 用药 */
.medicine-card.data-v-603752d0 {
  margin-top: 26rpx;

  padding: 36rpx;

  border-radius: 38rpx;

  background: #ffffff;

  box-shadow:
    0 20rpx 60rpx
    rgba(51,79,63,.10);
}
.medicine-top.data-v-603752d0 {
  display: flex;
  align-items: center;
}
.medicine-icon.data-v-603752d0 {
  width: 112rpx;
  height: 112rpx;

  margin-right: 28rpx;

  border-radius: 30rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #edf3e8;

  font-size: 56rpx;
}
.medicine-main.data-v-603752d0 {
  flex: 1;
}
.medicine-label.data-v-603752d0 {
  display: block;

  font-size: 30rpx;

  color: #7b857e;
}
.medicine-title.data-v-603752d0 {
  display: block;

  margin-top: 8rpx;

  font-size: 52rpx;

  line-height: 1.15;

  font-weight: 900;

  color: #20352b;
}
.medicine-detail.data-v-603752d0 {
  display: block;

  margin-top: 12rpx;

  font-size: 32rpx;

  color: #66736c;
}
.done-btn.data-v-603752d0 {
  margin-top: 34rpx;

  height: 118rpx;
  line-height: 118rpx;

  border-radius: 30rpx;

  background: #2e654e;

  color: #fff;

  font-size: 40rpx;

  font-weight: 900;

  box-shadow:
    0 14rpx 30rpx
    rgba(46,101,78,.18);
}
.done-btn.finished.data-v-603752d0 {
  background: #87978f;
}


/* 主功能 */
.main-actions.data-v-603752d0 {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 20rpx;

  margin-top: 22rpx;
}
.action-card.data-v-603752d0 {
  min-height: 230rpx;

  padding: 30rpx;

  border-radius: 34rpx;
}
.call.data-v-603752d0 {
  background: #f3ecde;
}
.assistant.data-v-603752d0 {
  background: #e7f0e8;
}
.action-icon.data-v-603752d0 {
  width: 76rpx;
  height: 76rpx;

  border-radius: 22rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: rgba(255,255,255,.55);

  font-size: 42rpx;
}
.action-title.data-v-603752d0 {
  display: block;

  margin-top: 24rpx;

  font-size: 38rpx;

  font-weight: 900;

  color: #263a31;
}
.action-sub.data-v-603752d0 {
  display: block;

  margin-top: 10rpx;

  font-size: 26rpx;

  line-height: 1.5;

  color: #6f7a73;
}


/* SOS */
.sos-card.data-v-603752d0 {
  margin-top: 22rpx;

  min-height: 146rpx;

  padding: 26rpx 28rpx;

  border-radius: 34rpx;

  display: flex;
  align-items: center;

  background: #fff2ef;

  border: 2rpx solid #efd6d1;
}
.sos-circle.data-v-603752d0 {
  width: 96rpx;
  height: 96rpx;

  margin-right: 24rpx;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #c84c43;

  color: #fff;

  font-size: 30rpx;

  font-weight: 900;

  box-shadow:
    0 10rpx 24rpx
    rgba(200,76,67,.20);
}
.sos-main.data-v-603752d0 {
  flex: 1;
}
.sos-title.data-v-603752d0 {
  display: block;

  font-size: 38rpx;

  font-weight: 900;

  color: #7e3832;
}
.sos-sub.data-v-603752d0 {
  display: block;

  margin-top: 8rpx;

  font-size: 25rpx;

  line-height: 1.45;

  color: #956d67;
}
.bottom-note.data-v-603752d0 {
  margin-top: 26rpx;

  text-align: center;

  font-size: 24rpx;

  color: #879089;
}