.page.data-v-f017fee7 {

  min-height: 100vh;

  padding:
    0
    28rpx
    180rpx;

  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(229, 240, 230, .8),
      transparent 28%
    ),
    linear-gradient(
      180deg,
      #f8f8f4,
      #f3f3ee
    );
}


/* =========================
   Hero
========================= */
.hero.data-v-f017fee7 {

  margin:
    48rpx
    6rpx
    30rpx;
}
.eyebrow.data-v-f017fee7 {

  display: block;

  font-size: 22rpx;

  letter-spacing: 2rpx;

  color: #87918a;
}
.hero-title.data-v-f017fee7 {

  display: block;

  margin-top: 10rpx;

  max-width: 650rpx;

  font-size: 46rpx;

  font-weight: 900;

  line-height: 1.3;

  color: #24392e;
}
.hero-desc.data-v-f017fee7 {

  display: block;

  margin-top: 15rpx;

  font-size: 23rpx;

  line-height: 1.7;

  color: #79847d;
}


/* =========================
   社区
========================= */
.community-card.data-v-f017fee7 {

  padding: 30rpx;

  border-radius: 34rpx;

  background:
    linear-gradient(
      135deg,
      #e7f1e7,
      #f8faf5
    );

  border:
    2rpx solid
    rgba(219,231,219,.8);

  box-shadow:
    0 14rpx 38rpx
    rgba(49,79,62,.06);
}
.community-top.data-v-f017fee7 {

  display: flex;

  align-items: center;
}
.community-icon.data-v-f017fee7 {

  width: 88rpx;
  height: 88rpx;

  flex-shrink: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 26rpx;

  background: rgba(255,255,255,.72);

  font-size: 40rpx;
}
.community-main.data-v-f017fee7 {

  flex: 1;

  margin-left: 20rpx;
}
.community-label.data-v-f017fee7,
.community-name.data-v-f017fee7,
.community-distance.data-v-f017fee7 {

  display: block;
}
.community-label.data-v-f017fee7 {

  font-size: 19rpx;

  color: #77847b;
}
.community-name.data-v-f017fee7 {

  margin-top: 5rpx;

  font-size: 29rpx;

  font-weight: 900;

  color: #30473a;
}
.community-distance.data-v-f017fee7 {

  margin-top: 6rpx;

  font-size: 20rpx;

  color: #79847d;
}
.online.data-v-f017fee7 {

  padding:
    7rpx
    13rpx;

  border-radius: 15rpx;

  background: #fff;

  font-size: 18rpx;

  color: #4f735d;
}
.community-actions.data-v-f017fee7 {

  display: grid;

  grid-template-columns:
    1fr
    1fr;

  gap: 14rpx;

  margin-top: 25rpx;
}
.community-btn.data-v-f017fee7 {

  height: 70rpx;

  line-height: 70rpx;

  text-align: center;

  border-radius: 20rpx;

  background: #35674f;

  color: #fff;

  font-size: 22rpx;

  font-weight: 800;
}
.community-btn.light.data-v-f017fee7 {

  background: rgba(255,255,255,.86);

  color: #436451;

  border:
    1rpx solid
    rgba(210,222,212,.9);
}


