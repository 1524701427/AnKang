}
.menu-title.data-v-602d69f1 {

  font-size: 25rpx;

  font-weight: 800;

  color: #34473d;
}
.menu-desc.data-v-602d69f1 {

  margin-top: 6rpx;

  font-size: 19rpx;

  color: #8a928d;
