<view class="page data-v-d7d08b31"><view class="form card data-v-d7d08b31"><text class="label data-v-d7d08b31">提醒类型</text><picker class="data-v-d7d08b31" range="{{b}}" bindchange="{{c}}"><view class="input data-v-d7d08b31">{{a}}</view></picker><text class="label data-v-d7d08b31">提醒名称</text><input class="input data-v-d7d08b31" placeholder="例如：降压药" value="{{d}}" bindinput="{{e}}"/><text class="label data-v-d7d08b31">时间</text><picker class="data-v-d7d08b31" mode="time" value="{{g}}" bindchange="{{h}}"><view class="input data-v-d7d08b31">{{f}}</view></picker><text class="label data-v-d7d08b31">剂量 / 内容</text><input class="input data-v-d7d08b31" placeholder="例如：1片" value="{{i}}" bindinput="{{j}}"/><text class="label data-v-d7d08b31">未确认多久通知家人</text><picker class="data-v-d7d08b31" range="{{l}}" bindchange="{{m}}"><view class="input data-v-d7d08b31">{{k}}</view></picker><view class="switch-row data-v-d7d08b31"><text class="data-v-d7d08b31">启用提醒</text><switch class="data-v-d7d08b31" checked="{{n}}" color="#326a53" bindchange="{{o}}"/></view><button class="save data-v-d7d08b31" bindtap="{{p}}">保存提醒</button></view></view>